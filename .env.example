# Required: Path to OAuth client secrets JSON or service account key
GOOGLE_GSC_CREDENTIALS_PATH=./credentials.json

# Optional: Path to cached OAuth token (default: derived from credentials path)
# GOOGLE_GSC_TOKEN_PATH=./credentials_token.json

# Optional: Default GSC property URL (auto-resolved if bare domain)
# GOOGLE_GSC_PROPERTY=sc-domain:example.com

# Optional: Enable write tools (add_site, delete_site, submit_sitemap, delete_sitemap)
# GOOGLE_GSC_ENABLE_WRITES=true

# Optional: Enable extended analytics tools (reporting, SEO, technical suites)
# GOOGLE_GSC_ENABLE_EXTENDED_TOOLS=true

# Optional: Enable debug logging
# DEBUG=true
